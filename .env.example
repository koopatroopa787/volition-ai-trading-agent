# Volition always defaults to a simulated, non-trading demo.
VOLITION_MODE=demo
EXECUTION_MODE=preview
ALLOW_ORDER_SUBMISSION=false
SCHEDULER_ENABLED=true
AGENT_INTERVAL_MINUTES=15
# Required for state-changing controls in paper mode. Use a long random value.
OPERATOR_API_KEY=

# Required for the hackathon paper-account mode.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
HACKATHON_ACCOUNT_ID=
HACKATHON_STARTING_BALANCE=100000
HACKATHON_START_DATE=2026-08-28

# Alpaca CLI executable. Paper trading is the CLI default.
ALPACA_CLI_BIN=alpaca
ALPACA_OUTPUT=json

# Optional reasoning layer supplied by the hackathon technology partner.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Generic OpenAI-compatible model endpoint. These values override Featherless.
# For the included private Ollama deployment, use http://ollama:11434/v1.
REASONING_API_KEY=
REASONING_BASE_URL=
REASONING_MODEL=
REASONING_PROVIDER=
REASONING_ALLOW_UNAUTHENTICATED=false

# Optional free intelligence providers. The app falls back cleanly when omitted.
# MarketAux: 100 free requests/day and ticker-level sentiment.
MARKETAUX_API_TOKEN=
# FRED: free macroeconomic series; a free API key is required.
FRED_API_KEY=
# SEC requires an identifying User-Agent such as: Your Name your@email.com
SEC_USER_AGENT=
INTELLIGENCE_CACHE_MINUTES=15

# Runtime and risk constitution.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WATCHLIST=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA,AVGO,JPM,BAC,XOM,UNH,LLY,NFLX,COIN
DEEP_SCAN_LIMIT=5
SYMBOL_COOLDOWN_MINUTES=60
MAX_RISK_PER_TRADE_PCT=1.25
MAX_PORTFOLIO_OPEN_RISK_PCT=8.0
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITIONS=4
MIN_OPEN_INTEREST=500
MAX_BID_ASK_SPREAD_PCT=8.0
MAX_QUOTE_AGE_SECONDS=300
MIN_DTE=7
MAX_DTE=35
